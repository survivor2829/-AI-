:host {
  display: block;
  width: 100%;
}

.composer {
  display: flex;
  align-items: center;
  width: 100%;
  height: 108rpx;
  padding: 0 10rpx 0 28rpx;
  border: 2rpx solid #e6d7cd;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 34rpx rgba(83, 56, 39, 0.08);
  box-sizing: border-box;
}

.composer--large {
  height: 112rpx;
  border-color: rgba(185, 79, 44, 0.34);
  border-radius: 34rpx;
}

.composer__input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 80rpx;
  color: #2b211b;
  font-size: 28rpx;
  box-sizing: border-box;
}

.composer__placeholder {
  color: #a49890;
}

.composer__actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  height: 88rpx;
  box-sizing: border-box;
}

.composer__icon,
.composer__send {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
  box-sizing: border-box;
}

.composer__icon {
  border-radius: 28rpx;
}

.composer__icon--active {
  background: #fff0e6;
}

.composer__icon-image {
  width: 38rpx;
  height: 38rpx;
}

.composer__send {
  width: 80rpx;
  height: 80rpx;
  margin-left: 2rpx;
  border-radius: 50%;
  background: #b94f2c;
}

.composer__send--disabled {
  background: #d9cec7;
}

.composer__send-image {
  width: 36rpx;
  height: 36rpx;
}
